[
 {
  "id": "ch1_outro",
  "kind": "story",
  "text": "מִתּוֹךְ הָעֲרָפֶל שֶׁל הָאִי הַבָּא הִבְהֲבוּ שְׁתֵּי עֵינַיִם צְהֻבּוֹת... מִי מִסְתַּתֵּר שָׁם? בַּפֶּרֶק הַבָּא נְגַלֶּה!"
 },
 {
  "id": "ch2_intro",
  "kind": "story",
  "text": "בַּפֶּרֶק הַקּוֹדֵם מָצָאנוּ אֶת הָאוֹתִיּוֹת מ, ב, א. עַכְשָׁו הָעֲרָפֶל נֶעֱלָם, וְעַל הָאִי הַבָּא רוֹאִים שְׁתֵּי עֵינַיִם צְהֻבּוֹת. אֲבָל אֵלּוּ לֹא עֵינַיִם! אֵלּוּ הַחַלּוֹנוֹת שֶׁל פַּנַּס הַיָּם, וְהוּא כָּבוּי."
 },
 {
  "id": "ch2_outro",
  "kind": "story",
  "text": "הַפַּנָּס נִדְלַק! מִתּוֹךְ מְעָרָה גְדוֹלָה בָּאָה מַנְגִּינָה עֲצוּבָה... מִי שָׁר שָׁם לְבַדּוֹ?"
 },
 {
  "id": "ch3_intro",
  "kind": "story",
  "text": "בַּמְּעָרָה יוֹשֵׁב לִוְיָתָן קָטָן וְעָצוּב. הוּא שָׁכַח אֶת מִלּוֹת הַשִּׁיר שֶׁלּוֹ, כִּי חָסְרוּ בָּהֶן אוֹתִיּוֹת. בּוֹאוּ נַחֲזִיר לוֹ אוֹתָן!"
 },
 {
  "id": "ch3_outro",
  "kind": "story",
  "text": "הַלִּוְיָתָן שָׁר שׁוּב! הוּא לוֹחֵשׁ: בְּשׁוּק הַצְּדָפִים מְחַכָּה לָנוּ חֲתִיכָה שֶׁל מַפָּה."
 },
 {
  "id": "ch4_intro",
  "kind": "story",
  "text": "הִגַּעְנוּ לְשׁוּק הַצְּדָפִים. הָאוֹתִיּוֹת נֶעֶלְמוּ מֵהַשְּׁלָטִים! אִם נַחֲזִיר אוֹתָן, הַדָּג הַמּוֹכֵר יִתֵּן לָנוּ חֲתִיכָה שֶׁל מַפָּה."
 },
 {
  "id": "ch4_outro",
  "kind": "story",
  "text": "קִבַּלְנוּ חֲתִיכָה שֶׁל מַפָּה! הִיא מַרְאָה גַּן שֶׁכָּל הַצְּבָעִים שֶׁלּוֹ דָּהוּ: גַּן הָאַלְמוֹגִים."
 },
 {
  "id": "ch5_intro",
  "kind": "story",
  "text": "הַמַּפָּה הוֹבִילָה אוֹתָנוּ לְגַן הָאַלְמוֹגִים. הַסְּעָרָה לָקְחָה מִמֶּנּוּ אֶת הַצְּבָעִים. כָּל אוֹת שֶׁנִּמְצָא תַּחְזִיר צֶבַע אֶחָד!"
 },
 {
  "id": "ch5_outro",
  "kind": "story",
  "text": "הַגַּן נִצְבַּע שׁוּב! בַּמֶּרְחָק רוֹאִים סְפִינָה יְשָׁנָה שֶׁשָּׁקְעָה, וּמִתּוֹכָהּ בָּא אוֹר קָטָן."
 },
 {
  "id": "ch6_intro",
  "kind": "story",
  "text": "בְּתוֹךְ הַסְּפִינָה יֵשׁ אָרוֹן נָעוּל בִּשְׁלוֹשָׁה מַנְעוּלִים. עַל כָּל מַנְעוּל כְּתוּבָה אוֹת. נִמְצָא אוֹתָן וְנִפְתַּח!"
 },
 {
  "id": "ch6_outro",
  "kind": "story",
  "text": "הָאָרוֹן נִפְתַּח, וּבְתוֹכוֹ סֵפֶר יָשָׁן! הוּא לוֹחֵשׁ: הָאוֹתִיּוֹת הָאַחֲרוֹנוֹת מְחַכּוֹת בְּסִפְרִיַּת הַיָּם."
 },
 {
  "id": "ch7_intro",
  "kind": "story",
  "text": "הִגַּעְנוּ לְסִפְרִיַּת הַיָּם. אַרְבַּע הָאוֹתִיּוֹת הָאַחֲרוֹנוֹת מִתְחַבְּאוֹת בֵּין הַסְּפָרִים. כְּשֶׁנִּמְצָא אוֹתָן, הַמִּפְרָץ יַחֲזֹר לִהְיוֹת כְּמוֹ פַּעַם!"
 },
